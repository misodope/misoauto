generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int             @id @default(autoincrement())
  email          String          @unique
  password       String
  name           String?
  phoneNumber    String? @map("phone_number") @db.VarChar(50)
  smsConsent     Boolean         @default(false) @map("sms_consent")
  emailConsent   Boolean         @default(false) @map("email_consent")
  approvedAt     DateTime?       @map("approved_at")
  deletedAt      DateTime?       @map("deleted_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  socialAccounts SocialAccount[]
  videos         Video[]
  refreshTokens  RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  userId    Int      @map("user_id")
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Video {
  id          Int         @id @default(autoincrement())
  title       String
  description String?
  s3Key        String      @map("s3_key")
  s3ThumbnailKey String?   @map("s3_thumbnail_key")
  s3Bucket     String      @map("s3_bucket")
  duration    Float?
  fileSize    Int?        @map("file_size")
  mimeType    String?     @map("mime_type")
  status      VideoStatus @default(PROCESSING)
  userId      Int         @map("user_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")
  deletedAt   DateTime?   @map("deleted_at")
  user        User             @relation(fields: [userId], references: [id])
  posts       VideoPost[]
  drafts      VideoPostDraft[]

  @@map("videos")
}

model Platform {
  id          Int             @id @default(autoincrement())
  name        PlatformType    @unique
  displayName String          @map("display_name")
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  accounts    SocialAccount[]
  posts       VideoPost[]
  drafts      VideoPostDraft[]

  @@map("platforms")
}

model SocialAccount {
  id           Int         @id @default(autoincrement())
  platformId   Int         @map("platform_id")
  userId       Int         @map("user_id")
  accessToken  String?     @map("access_token")
  refreshToken String?     @map("refresh_token")
  tokenExpiry  DateTime?   @map("token_expiry")
  accountId    String      @map("account_id")
  appScopedUserId String?  @map("app_scoped_user_id")
  username     String
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  deletedAt    DateTime?   @map("deleted_at")
  disconnectState SocialAccountDisconnectState @default(ACTIVE) @map("disconnect_state")
  disconnectStartedAt DateTime? @map("disconnect_started_at")
  disconnectError String? @map("disconnect_error")
  tokenVersion Int @default(0) @map("token_version")
  platform     Platform    @relation(fields: [platformId], references: [id])
  user         User        @relation(fields: [userId], references: [id])
  posts        VideoPost[]

  @@unique([platformId, accountId])
  @@index([platformId, appScopedUserId])
  @@map("social_accounts")
}

model VideoPost {
  id              Int           @id @default(autoincrement())
  videoId         Int           @map("video_id")
  platformId      Int           @map("platform_id")
  socialAccountId Int           @map("social_account_id")
  platformPostId  String?       @map("platform_post_id")
  postUrl         String?       @map("post_url")
  status          PostStatus    @default(PENDING)
  scheduledFor    DateTime?     @map("scheduled_for")
  postedAt        DateTime?     @map("posted_at")
  // What to post, snapshotted per platform when the post is created:
  // - title: YouTube title
  // - caption: Instagram caption, YouTube description, or TikTok caption
  //   (kept for a future Direct Post)
  // - options: platform settings — YouTube { privacyStatus, madeForKids },
  //   Instagram { shareToFeed }, TikTok {}
  uploadMode      UploadMode    @default(DRAFT) @map("upload_mode")
  title           String?
  caption         String?
  options         Json?
  // Groups the posts created by one schedule/publish confirmation
  batchId         String?       @map("batch_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")
  cancellationReason String?    @map("cancellation_reason")
  platform        Platform         @relation(fields: [platformId], references: [id])
  socialAccount   SocialAccount    @relation(fields: [socialAccountId], references: [id])
  video           Video            @relation(fields: [videoId], references: [id])

  @@index([batchId])
  @@index([status, scheduledFor])
  @@map("video_posts")
}

model VideoPostDraft {
  id                Int       @id @default(autoincrement())
  videoId           Int       @map("video_id")
  platformId        Int?      @map("platform_id")
  platformVideoId   String    @map("platform_video_id")
  uploadCompletedAt DateTime? @map("upload_completed_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")
  video             Video     @relation(fields: [videoId], references: [id])
  platform          Platform? @relation(fields: [platformId], references: [id])

  @@map("video_post_drafts")
}

enum VideoStatus {
  PROCESSING
  READY
  FAILED
}

enum PostStatus {
  PENDING
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

enum SocialAccountDisconnectState {
  ACTIVE
  DISCONNECTING
  DISCONNECTED
}

enum UploadMode {
  DRAFT
  DIRECT
}

enum PlatformType {
  TIKTOK
  YOUTUBE
  INSTAGRAM
  FACEBOOK
}

model DataDeletionRequest {
  id               Int                @id @default(autoincrement())
  confirmationCode String             @unique @map("confirmation_code")
  platform         PlatformType
  source           DataDeletionSource
  status           DataDeletionStatus @default(PENDING)
  dataFound        Boolean            @default(false) @map("data_found")
  requestedAt      DateTime           @default(now()) @map("requested_at")
  completedAt      DateTime?          @map("completed_at")

  @@map("data_deletion_requests")
}

enum DataDeletionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum DataDeletionSource {
  META_DATA_DELETION
}
