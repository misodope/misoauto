{
  "name": "backend",
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd backend && ./node_modules/.bin/prisma generate && ./node_modules/.bin/ts-node -r tsconfig-paths/register -P tsconfig.json src/main.ts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd backend && ./node_modules/.bin/prisma generate && ./node_modules/.bin/nest build"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "cd backend && ./node_modules/.bin/prisma generate && ./node_modules/.bin/jest"
      }
    }
  }
}
